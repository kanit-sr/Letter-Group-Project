generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  username        String   @unique
  email           String   @unique
  passwordHash    String   @map("password_hash")
  avatarUrl       String?  @map("avatar_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  house           House?
  sentLetters     Letter[] @relation("LettersSent")
  receivedLetters Letter[] @relation("LettersReceived")

  @@map("users")
}

model House {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  roofColor    String   @default("#8B4513") @map("roof_color")
  doorStyle    String   @default("classic") @map("door_style")
  wallColor    String   @default("#E8D7C3") @map("wall_color")
  gardenConfig Json     @default("{}") @map("garden_config")
  mailboxStyle String   @default("default") @map("mailbox_style")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("houses")
}

model Letter {
  id           String   @id @default(uuid()) @db.Uuid
  senderId     String   @map("sender_id") @db.Uuid
  recipientId  String?  @map("recipient_id") @db.Uuid
  subject      String
  body         String
  designConfig Json     @default("{}") @map("design_config")
  isPublic     Boolean  @default(false) @map("is_public")
  isRead       Boolean  @default(false) @map("is_read")
  sentAt       DateTime @default(now()) @map("sent_at")

  sender    User  @relation("LettersSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User? @relation("LettersReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("letters")
}
