# Backend environment template for Letter Village
# Copy this file to .env in backend/ and fill in real values.

PORT=5000
NODE_ENV="development"

# MongoDB
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="letter_village"

# Demo data (accounts/letters from src/seed/demoData.js).
# Defaults to on in in-memory mode. Force on a real DB with SEED_DEMO=true,
# or turn off with SEED_DEMO=false.
# SEED_DEMO="true"

# Auth
JWT_SECRET="replace-with-a-strong-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary (image/sticker storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
